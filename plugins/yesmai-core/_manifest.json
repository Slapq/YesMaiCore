{
  "manifest_version": 2,
  "id": "com.yesmai.core",
  "version": "0.1.3",
  "name": "YesMaiCore",
  "description": "YesMai 系列插件的能力中枢与接口核心，透明代理 MaiBot Host 能力并提供稳定的跨插件协议。",
  "author": {
    "name": "Slapq",
    "url": "https://github.com/Slapq"
  },
  "license": "GPL-3.0-only",
  "urls": {
    "repository": "https://github.com/Slapq/YesMaiCore"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.7.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "tomlkit",
      "version_spec": ">=0.13.3,<1.0.0"
    },
    {
      "type": "python_package",
      "name": "tzdata",
      "version_spec": ">=2024.1"
    }
  ],
  "plugin_type": "management",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "boxes"
    }
  },
  "capabilities": [
    "send.text",
    "send.hybrid",
    "llm.generate",
    "message.get_recent",
    "message.get_by_time_in_chat",
    "person.get_id",
    "render.html2png",
    "chat.get_group_streams",
    "chat.get_private_streams",
    "api.list",
    "api.call",
    "component.list_loaded_plugins",
    "component.list_registered_plugins",
    "component.load_plugin",
    "component.reload_plugin"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
